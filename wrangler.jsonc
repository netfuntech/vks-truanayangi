// Cloudflare Workers static assets deployment for the built Vite site.
// Build first (`pnpm build`), then `pnpm deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truanayangi",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
